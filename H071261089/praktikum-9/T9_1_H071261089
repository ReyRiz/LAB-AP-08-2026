class Pemain:
    def __init__(self, nama, id_pemain, role, nilai_kill, nilai_assist, nilai_objective):
        self.nama = nama
        self.id_pemain = id_pemain
        self.role = role
        self.nilai_kill = nilai_kill
        self.nilai_assist = nilai_assist
        self.nilai_objective = nilai_objective

    def hitung_skor_akhir(self):
        skor = (0.3 * self.nilai_kill) + (0.3 * self.nilai_assist) + (0.4 * self.nilai_objective)
        return round(skor, 2)

    def status_performa(self):
        if self.hitung_skor_akhir() >= 60:
            return "Unggul"
        else:
            return "Perlu Evaluasi"

    def tampilkan_data(self, nomor):
        print(f"| {nomor:<3} | {self.nama:<20} | {self.id_pemain:<12} | {self.role:<12} | {self.hitung_skor_akhir():<10.2f} | {self.status_performa():<14} |")


def input_angka(pesan):
    while True:
        try:
            angka = float(input(pesan))
        except ValueError:
            print("Input harus berupa angka!")
            continue
        if angka < 0:
            print("Nilai tidak boleh negatif!")
            continue
        return angka


print("=== SISTEM PENILAIAN PERFORMA PEMAIN ===")
print()

while True:
    try:
        jumlah = int(input("Masukkan jumlah pemain: "))
    except ValueError:
        print("Input harus berupa angka bulat!")
        continue
    if jumlah <= 0:
        print("Jumlah pemain harus lebih dari 0!")
        continue
    break

daftar_pemain = []

for i in range(1, jumlah + 1):
    print()
    print(f"-- Data Pemain ke-{i} --")
    nama = input("Nama: ")
    id_pemain = input("ID Pemain: ")
    role = input("Role: ")
    nilai_kill = input_angka("Nilai Kill: ")
    nilai_assist = input_angka("Nilai Assist: ")
    nilai_objective = input_angka("Nilai Objective: ")

    pemain = Pemain(nama, id_pemain, role, nilai_kill, nilai_assist, nilai_objective)
    daftar_pemain.append(pemain)

garis = "=" * 90

print()
print("=== REKAPITULASI PERFORMA PEMAIN ===")
print(garis)
print(f"| {'No':<3} | {'Nama':<20} | {'ID Pemain':<12} | {'Role':<12} | {'Skor Akhir':<10} | {'Status':<14} |")

ALFABET = "abcdefghijklmnopqrstuvwxyz"


def bersihkan_teks(teks):
    hasil = ""
    for ch in teks:
        if ALFABET.find(ch.lower()) != -1:
            hasil = hasil + ch.lower()
    return hasil


def cek_palinrome(teks):
    terbalik = "".join(reversed(teks))
    if teks == terbalik:
        return (True, -1)
    for i in range(len(teks)):
        if teks[i] != terbalik[i]:
            return (False, i)


def inti_palinrome(teks):
    terbaik = ""
    indeks = 0
    for i in range(len(teks)):
        for j in range(i + 1, len(teks) + 1):
            sub = teks[i:j]
            if len(sub) > len(terbaik):
                hasil_cek = cek_palinrome(sub)
                if hasil_cek[0]:
                    terbaik = sub
                    indeks = i
    return {"teks": terbaik, "panjang": len(terbaik), "indeks_awal": indeks}


teks = input("Masukkan teks prasasti: ")
bersih = bersihkan_teks(teks)
print()
print("Teks Bersih:", bersih)
print("Output Terharap:", inti_palinrome(bersih))
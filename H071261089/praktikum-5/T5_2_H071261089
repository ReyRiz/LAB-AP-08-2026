ALFABET = "abcdefghijklmnopqrstuvwxyz"


def cek_kata(teks, kata):
    teks_kecil = teks.lower()
    kata_kecil = kata.lower()
    daftar = []
    start = 0
    while True:
        i = teks_kecil.find(kata_kecil, start)
        if i == -1:
            break
        daftar = daftar + [i]
        start = i + 1
    return daftar


def cek_batas_kata(teks, i, panjang):
    if i > 0:
        sebelum = teks[i - 1].lower()
        if ALFABET.find(sebelum) != -1:
            return False
    akhir = i + panjang
    if akhir < len(teks):
        sesudah = teks[akhir].lower()
        if ALFABET.find(sesudah) != -1:
            return False
    return True


def sensor_kata(teks, kata, simbol):
    semua = cek_kata(teks, kata)
    panjang = len(kata)
    hasil = ""
    posisi = 0
    indeks_sensor = []
    for i in semua:
        if cek_batas_kata(teks, i, panjang):
            hasil = hasil + teks[posisi:i] + simbol * panjang
            posisi = i + panjang
            indeks_sensor = indeks_sensor + [i]
    hasil = hasil + teks[posisi:]
    return (hasil, len(indeks_sensor), indeks_sensor)


teks = input("Masukkan Teks: ")
kata = input("Masukkan kata target: ")
simbol = input("Masukkan simbol: ")

hasil = sensor_kata(teks, kata, simbol)
print("Hasil Teks:", hasil[0])
print("Jumlah:", hasil[1], "| Indeks:", hasil[2])